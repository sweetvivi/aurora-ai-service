<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.hub</groupId>
    <artifactId>backend-service</artifactId>
    <version>0.6.0</version>
    <name>backend-service</name>
    <description>Common Spring Boot backend baseline</description>

    <properties>
        <java.version>17</java.version>
        <springdoc.version>2.8.13</springdoc.version>
        <springdoc-openapi-maven-plugin.version>1.5</springdoc-openapi-maven-plugin.version>
        <knife4j.version>4.5.0</knife4j.version>
        <shedlock.version>6.9.2</shedlock.version>
        <!--
          源码与资源一律按 UTF-8 处理。

          不写这一行时，Maven 会退到平台的默认编码：Windows 中文环境下是 GBK，
          于是本仓库里所有 UTF-8 的中文字面量（ApiMessages 里那一批用户可见文案）
          编译后全成乱码，测试比对文案时一条条失败，报错信息也全是问号。
          这类失败看着像逻辑 bug，实际只需要一个编码声明。

          argLine 一并把 JVM 的 file.encoding 固定住：测试运行在同一 JVM 里，
          少了它，编译期正确的字面量在运行期读文件 / 拼响应时仍可能按 GBK 解码。
        -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <argLine>-Dfile.encoding=UTF-8</argLine>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
            抓取端要的是文本协议，不是 actuator 的 JSON。没有这个 registry 的话，
            /actuator/metrics 里能查到值，但接不进任何监控系统 —— 等于白做。
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!--
          审计日志用注解 + AOP 拦截管理端写接口。Spring AOP 是 Spring Framework 自带的，
          这里只是把 starter 拉进来（aspectjweaver + 自动代理），没有引入完整 AspectJ 编译器。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <!--
            多实例下的定时任务互斥。

            @Scheduled 只保证「每个进程各跑一次」：两个副本时目录同步会各拉一遍全量快照，
            视频轮询会各打一遍上游状态接口，写的还是同一张表。ShedLock 用一张 shedlock 表
            做租约，抢不到的直接跳过这一轮 —— 它不排队、不重试，正好符合定时任务「错过就等
            下一轮」的语义。

            只用 jdbc-template provider（项目已经有 DataSource），不引 redis/mongo 实现。
            usingDbTime() 见 SchedulingLockConfig：以数据库时间为准，避免多机时钟漂移。
        -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
            <version>${shedlock.version}</version>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>${shedlock.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!--
            跨实例共享状态：限流计数、进行中的生成请求（停止生成要能打到当事实例）。

            只有需要多副本或需要「重启不丢计数」时才启用（app.redis.enabled）。单实例部署
            保持关闭，退回进程内实现 —— 本地开发与整套测试因此都不依赖 Redis。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
            Password hashing only. This is the standalone crypto jar, not the Spring Security
            starter, so it brings no filter chain or auto-configuration: authorisation stays in
            modules/auth + CurrentUserResolver until the RBAC work lands.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.78.1</version>
        </dependency>
        <!--
            springdoc core plus its WebMvc integration: this publishes /v3/api-docs, which is all
            this project needs from springdoc.

            The `-ui` artifact is deliberately NOT used. It would register
            /v3/api-docs/swagger-config — the endpoint Knife4j reads to discover the document — but
            it also ships the whole Swagger UI console, and turning that off with
            `springdoc.swagger-ui.enabled=false` removes swagger-config with it. So the one needed
            endpoint is served by SwaggerConfigEndpoint instead, and Swagger UI stays off the
            classpath entirely.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <!--
            Knife4j serves the API documentation console at /doc.html: a modern, Chinese-first UI
            with request debugging, grouped operations and offline export. It is the only console.

            Only the UI webjar is pulled in, not the `knife4j-openapi3-jakarta-spring-boot-starter`.
            The starter's autoconfiguration is compiled against an older springdoc and calls
            `SpringDocConfigProperties.getGroupConfigs()`, whose signature changed in springdoc 2.8,
            which broke /v3/api-docs with NoSuchMethodError. The webjar is pure front-end assets
            served from META-INF/resources, so springdoc stays at ${springdoc.version} untouched.
        -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-ui</artifactId>
            <version>${knife4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Chat attachment text extraction: PDF / DOCX / XLSX / PPTX → prompt -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.4</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.4.0</version>
        </dependency>
        <!-- Markdown → native DOCX for generate_docx (POI 5.x stack) -->
        <dependency>
            <groupId>com.deepoove</groupId>
            <artifactId>poi-tl</artifactId>
            <version>1.12.2</version>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.poi</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.deepoove</groupId>
            <artifactId>poi-tl-plugin-markdown</artifactId>
            <version>1.0.3</version>
            <exclusions>
                <exclusion>
                    <groupId>com.deepoove</groupId>
                    <artifactId>poi-tl</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.poi</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Automatic API documentation.

            Runtime documentation is already generated by springdoc at /swagger-ui.html and
            /v3/api-docs. This profile additionally exports the machine readable contract to
            target/openapi/openapi.json so it can be committed, diffed in review or fed into a
            client generator:

                mvnw.cmd -Popenapi verify -DskipTests
        -->
        <profile>
            <id>openapi</id>
            <properties>
                <!-- Dedicated port so the export does not collide with a running dev server. -->
                <openapi.export.port>18080</openapi.export.port>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>start-application-for-openapi-export</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>start</goal>
                                </goals>
                                <configuration>
                                    <wait>30000</wait>
                                    <arguments>
                                        <argument>--server.port=${openapi.export.port}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>stop-application-after-openapi-export</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>stop</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.springdoc</groupId>
                        <artifactId>springdoc-openapi-maven-plugin</artifactId>
                        <version>${springdoc-openapi-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>export-openapi-contract</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <apiDocsUrl>http://localhost:${openapi.export.port}/v3/api-docs</apiDocsUrl>
                            <outputFileName>openapi.json</outputFileName>
                            <outputDir>${project.build.directory}/openapi</outputDir>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
