MYSQL_IMAGE=mysql:8.4
MYSQL_DATABASE=hub_test
MYSQL_USER=hub_test
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
ADMIN_API_KEY=replace-with-a-long-random-key
NEW_API_BASE_URL=https://api.example.com
LLM_BASE_URL=https://api.example.com/v1
NEW_API_ENCRYPTION_KEY=replace-with-base64-32-byte-aes-key
NEW_API_TOKEN_NAME_PREFIX=hub
NEW_API_GROUP=default
# Optional: read-only account for the model plaza sync. Needed once New API sets the
# pricing nav module to requireAuth; its own group decides which models are returned.
NEW_API_CATALOG_USERNAME=
NEW_API_CATALOG_PASSWORD=
AUTH_NEW_API_ACCOUNT_PROVISIONING_ENABLED=true
# Email verification is owned by New API. AUTO follows its /api/status → email_verification.
AUTH_EMAIL_VERIFICATION_REGISTER_MODE=AUTO
# Leave false until every existing account has a verified address, otherwise sign-in is blocked for all.
AUTH_EMAIL_VERIFICATION_LOGIN_REQUIRED=false
# Optional since V83: the download key now lives on the provider row
# (llm_providers.video_download_api_key). Set it only if you still keep it here.
LLM_VIDEO_DOWNLOAD_API_KEY=
TZ=Asia/Shanghai
FRONTEND_VERSION=20261031-150258187
BACKEND_VERSION=20261031-150258187
